            "servertype": "openocd",
            "serverpath": "C:/msys64/ucrt64/bin/openocd.exe",
            "configFiles": [
                "openocd_stlink.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "build",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
