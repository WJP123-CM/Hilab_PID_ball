{
    "version": "0.2.0",
    "configurations": [
        // ===== J-Link + OpenOCD 调试（launch）=====
        {
            "name": "JLink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/Hilab_PID.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F103C8",
            "svdFile": "${workspaceFolder}/STM32F103xx.svd",
            "gdbPath": "C:/msys64/ucrt64/bin/gdb-multiarch.exe",
            "armToolchainPath": "C:/msys64/ucrt64/bin",
            "servertype": "openocd",
            "serverpath": "C:/msys64/ucrt64/bin/openocd.exe",
            "configFiles": [
                "openocd_jlink.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "build", // 关键修正
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        // ===== ST-Link + OpenO试（launch）=====
        {
            "name": "STLink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/Hilab_PID.elf",
